# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# --- OS ---
.DS_Store

# --- Data warehouse (too large for git; ship separately or rebuild) ---
# The uncompressed DuckDB is ~700MB. Keep it out of git. Either commit the
# compressed database/breakout.duckdb.zip via Git LFS, or share it out-of-band
# and unzip locally.
database/*.duckdb
database/breakout.duckdb.wal
my_database.db

# --- logs / scratch ---
logs/
*.log

# Claude Code local settings (machine-specific)
.claude/settings.local.json
